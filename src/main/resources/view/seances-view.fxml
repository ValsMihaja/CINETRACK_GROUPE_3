<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SeanceControleur"
      spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Séances" styleClass="page-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Actualiser" onAction="#rafraichirTable" styleClass="btn-secondary"/>
    </HBox>

    <Label fx:id="lblMessage" text="" styleClass="msg-error"/>

    <TableView fx:id="tableSeances" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colFilm" text="Film" prefWidth="250"/>
            <TableColumn fx:id="colSalle" text="Salle" prefWidth="140"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
            <TableColumn fx:id="colHeure" text="Horaire" prefWidth="140"/>
            <TableColumn fx:id="colPlaces" text="Places dispo" prefWidth="110"/>
        </columns>
    </TableView>

</VBox>
