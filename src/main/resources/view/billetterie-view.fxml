<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BilletterieControleur"
      spacing="14">

    <Label text="Billetterie" styleClass="page-title"/>
    <Label fx:id="lblMessage" text="" wrapText="true"/>

    <HBox spacing="14">
        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <Label text="Nouvelle réservation" styleClass="section-title"/>

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Séance" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbSeance" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Places dispo" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="lblPlacesRestantes" text="--" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Client" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbClient" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Tarif" styleClass="field-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbTarif" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Nb places" styleClass="field-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <HBox spacing="14" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
                    <Spinner fx:id="spNbPlaces" prefWidth="90"/>
                    <Label text="Total :" styleClass="field-label"/>
                    <Label fx:id="lblMontantCalcule" text="0.00 Rs" style="-fx-font-weight: bold;"/>
                </HBox>
            </GridPane>

            <HBox spacing="10">
                <Button text="Réserver" onAction="#onReserver" styleClass="btn-primary"/>
                <Button text="Annuler la sélection" onAction="#onAnnuler" styleClass="btn-danger"/>
            </HBox>
        </VBox>

        <VBox spacing="8" styleClass="card" prefWidth="340">
            <Label text="Billet" styleClass="section-title"/>
            <TextArea fx:id="txtBilletGenere" editable="false" prefHeight="200" styleClass="ticket-area"/>
        </VBox>
    </HBox>

    <TableView fx:id="tableReservations" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNumBillet" text="N° Billet" prefWidth="140"/>
            <TableColumn fx:id="colSeance" text="Séance" prefWidth="260"/>
            <TableColumn fx:id="colClient" text="Client" prefWidth="150"/>
            <TableColumn fx:id="colTarif" text="Tarif" prefWidth="120"/>
            <TableColumn fx:id="colNbPlaces" text="Places" prefWidth="70"/>
            <TableColumn fx:id="colMontant" text="Montant" prefWidth="100"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>
