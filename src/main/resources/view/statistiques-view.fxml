<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.StatistiqueControleur"
      spacing="14">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Statistiques et Administration" styleClass="page-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Exporter CSV" onAction="#onExporterRapportCSV" styleClass="btn-primary"/>
        <Button text="Actualiser" onAction="#rafraichirStatistiques" styleClass="btn-secondary"/>
    </HBox>

    <Label fx:id="lblMessageStats" text="" wrapText="true"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Statistiques">
            <VBox spacing="14">
                <padding>
                    <Insets top="12"/>
                </padding>

                <HBox spacing="14">
                    <VBox spacing="4" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <Label text="Chiffre d'affaires" styleClass="kpi-label"/>
                        <Label fx:id="lblKpiChiffreAffaires" text="0.00 Rs" styleClass="kpi-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <Label text="Billets vendus" styleClass="kpi-label"/>
                        <Label fx:id="lblKpiBilletsVendus" text="0" styleClass="kpi-value"/>
                    </VBox>
                    <VBox spacing="4" styleClass="kpi-card" HBox.hgrow="ALWAYS">
                        <Label text="Réservations confirmées" styleClass="kpi-label"/>
                        <Label fx:id="lblKpiReservations" text="0" styleClass="kpi-value"/>
                    </VBox>
                </HBox>

                <Label text="Films les plus réservés" styleClass="section-title"/>
                <TableView fx:id="tableTopFilms" prefHeight="180">
                    <columns>
                        <TableColumn fx:id="colTopTitre" text="Titre" prefWidth="250"/>
                        <TableColumn fx:id="colTopGenre" text="Genre" prefWidth="140"/>
                        <TableColumn fx:id="colTopNote" text="Note" prefWidth="100"/>
                        <TableColumn fx:id="colTopPlaces" text="Places vendues" prefWidth="130"/>
                        <TableColumn fx:id="colTopCA" text="Chiffre d'affaires" prefWidth="160"/>
                    </columns>
                </TableView>

                <Label text="Taux d'occupation par séance" styleClass="section-title"/>
                <TableView fx:id="tableOccupation" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colOccDate" text="Date" prefWidth="105"/>
                        <TableColumn fx:id="colOccHeure" text="Heure" prefWidth="85"/>
                        <TableColumn fx:id="colOccSalle" text="Salle" prefWidth="140"/>
                        <TableColumn fx:id="colOccFilm" text="Film" prefWidth="230"/>
                        <TableColumn fx:id="colOccPlaces" text="Occupation" prefWidth="120"/>
                        <TableColumn fx:id="colOccTaux" text="Taux" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab fx:id="tabAdministration" text="Administration">
            <VBox spacing="14">
                <padding>
                    <Insets top="12"/>
                </padding>

                <VBox spacing="10" styleClass="card">
                    <Label text="Gestion des comptes" styleClass="section-title"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtUserLogin" promptText="Identifiant" HBox.hgrow="ALWAYS"/>
                        <PasswordField fx:id="txtUserMdp" promptText="Mot de passe" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtUserNom" promptText="Nom" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtUserPrenom" promptText="Prénom" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="cbUserRole" prefWidth="130"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button text="Créer utilisateur" onAction="#onCreerUtilisateur" styleClass="btn-primary"/>
                        <Button text="Débloquer" onAction="#onDebloquerUtilisateur" styleClass="btn-secondary"/>
                        <Button text="Supprimer" onAction="#onSupprimerUtilisateur" styleClass="btn-danger"/>
                        <Button fx:id="btnSauvegardeBdd" text="Sauvegarder BDD" onAction="#onExecuterSauvegarde" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <TableView fx:id="tableUtilisateurs" prefHeight="155">
                    <columns>
                        <TableColumn fx:id="colUserId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colUserLogin" text="Identifiant" prefWidth="140"/>
                        <TableColumn fx:id="colUserNomComplet" text="Nom complet" prefWidth="220"/>
                        <TableColumn fx:id="colUserRole" text="Rôle" prefWidth="110"/>
                        <TableColumn fx:id="colUserStatut" text="Statut" prefWidth="180"/>
                    </columns>
                </TableView>

                <Label text="Logs de sécurité" styleClass="section-title"/>
                <TableView fx:id="tableLogs" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLogId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colLogDate" text="Date" prefWidth="150"/>
                        <TableColumn fx:id="colLogUser" text="Utilisateur" prefWidth="120"/>
                        <TableColumn fx:id="colLogAction" text="Action" prefWidth="180"/>
                        <TableColumn fx:id="colLogDetails" text="Détails" prefWidth="360"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

</VBox>
