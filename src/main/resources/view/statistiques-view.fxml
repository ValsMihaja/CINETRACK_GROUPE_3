<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.StatistiqueControleur"
      spacing="14">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Statistiques" styleClass="page-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Exporter CSV" onAction="#onExporterCSV" styleClass="btn-primary"/>
    </HBox>

    <Label fx:id="lblMessage" text="" wrapText="true"/>

    <HBox spacing="14">
        <VBox spacing="4" styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Chiffre d'affaires" styleClass="kpi-label"/>
            <Label fx:id="lblKpiChiffreAffaires" text="0.00 Rs" styleClass="kpi-value"/>
        </VBox>
        <VBox spacing="4" styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Billets vendus" styleClass="kpi-label"/>
            <Label fx:id="lblKpiBilletsVendus" text="0" styleClass="kpi-value"/>
        </VBox>
        <VBox spacing="4" styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Réservations confirmées" styleClass="kpi-label"/>
            <Label fx:id="lblKpiReservations" text="0" styleClass="kpi-value"/>
        </VBox>
    </HBox>

    <Label text="Films les plus réservés" styleClass="section-title"/>
    <TableView fx:id="tableTopFilms" prefHeight="180">
        <columns>
            <TableColumn fx:id="colTopTitre" text="Titre" prefWidth="250"/>
            <TableColumn fx:id="colTopGenre" text="Genre" prefWidth="140"/>
            <TableColumn fx:id="colTopNote" text="Note" prefWidth="100"/>
            <TableColumn fx:id="colTopPlaces" text="Places vendues" prefWidth="130"/>
            <TableColumn fx:id="colTopCA" text="Chiffre d'affaires" prefWidth="160"/>
        </columns>
    </TableView>

    <Label text="Taux d'occupation par séance" styleClass="section-title"/>
    <TableView fx:id="tableOccupation" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colOccDate" text="Date" prefWidth="105"/>
            <TableColumn fx:id="colOccHeure" text="Heure" prefWidth="85"/>
            <TableColumn fx:id="colOccSalle" text="Salle" prefWidth="140"/>
            <TableColumn fx:id="colOccFilm" text="Film" prefWidth="230"/>
            <TableColumn fx:id="colOccPlaces" text="Occupation" prefWidth="120"/>
            <TableColumn fx:id="colOccTaux" text="Taux" prefWidth="90"/>
        </columns>
    </TableView>

</VBox>
