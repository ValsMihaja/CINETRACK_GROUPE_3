<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.SalleControleur"
      spacing="12">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Salles" styleClass="page-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Actualiser" onAction="#rafraichirTable" styleClass="btn-secondary"/>
    </HBox>

    <Label fx:id="lblMessage" text="" styleClass="msg-error"/>

    <TableView fx:id="tableSalles" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
            <TableColumn fx:id="colCapacite" text="Capacité" prefWidth="120"/>
            <TableColumn fx:id="colEquipement" text="Équipement" prefWidth="360"/>
        </columns>
    </TableView>

</VBox>
