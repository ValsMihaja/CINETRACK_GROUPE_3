<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardControleur"
            prefWidth="1280.0" prefHeight="780.0">

    <!-- Barre de navigation latérale -->
    <left>
        <VBox styleClass="sidebar" prefWidth="255.0" spacing="12.0">
            <Label text="🎬 CINETRACK V2" styleClass="sidebar-title"/>
            <Label text="Cinéma Le Lumière" styleClass="sidebar-subtitle"/>

            <VBox spacing="4.0" style="-fx-padding: 8 0 8 0;">
                <Label fx:id="lblUtilisateurConnecte" text="Utilisateur" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                <Label fx:id="lblRoleBadge" text="ROLE" styleClass="role-badge"/>
            </VBox>

            <Separator/>

            <Button fx:id="btnNavBilletterie" text="🎟  Billetterie &amp; Clients"
                    onAction="#onAfficherBilletterie" styleClass="nav-btn" maxWidth="Infinity"/>

            <Button fx:id="btnNavProgrammation" text="🎞  Films, Salles &amp; Séances"
                    onAction="#onAfficherProgrammation" styleClass="nav-btn" maxWidth="Infinity"/>

            <Button fx:id="btnNavStatistiques" text="📊  Stats, Utilisateurs &amp; Logs"
                    onAction="#onAfficherStatistiques" styleClass="nav-btn" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>
            <Button text="🚪  Déconnexion" onAction="#onSeDeconnecter"
                    styleClass="btn-danger" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- Zone centrale dynamique -->
    <center>
        <StackPane fx:id="contentPane">
            <padding>
                <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>
