<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.DashboardControleur">

    <left>
        <VBox spacing="12" prefWidth="210" styleClass="sidebar">
            <Label text="CineTrack" styleClass="sidebar-brand"/>

            <VBox spacing="4" styleClass="sidebar-user-box">
                <Label fx:id="lblUtilisateurConnecte" text="Utilisateur" styleClass="sidebar-user" wrapText="true"/>
                <Label fx:id="lblRoleBadge" text="ROLE" styleClass="role-badge"/>
            </VBox>

            <Separator style="-fx-opacity: 0.2;"/>

            <VBox spacing="4">
                <Button fx:id="btnNavBilletterie" text="Billetterie"
                        onAction="#onAfficherBilletterie" maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="btnNavClients" text="Clients"
                        onAction="#onAfficherClients" maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="btnNavSeances" text="Séances"
                        onAction="#onAfficherSeances" maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="btnNavFilms" text="Films"
                        onAction="#onAfficherFilms" maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="btnNavSalles" text="Salles"
                        onAction="#onAfficherSalles" maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="btnNavTarifs" text="Tarifs"
                        onAction="#onAfficherTarifs" maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="btnNavStatistiques" text="Statistiques"
                        onAction="#onAfficherStatistiques" maxWidth="Infinity" styleClass="nav-btn"/>
                <Button fx:id="btnNavAdministration" text="Administration"
                        onAction="#onAfficherAdministration" maxWidth="Infinity" styleClass="nav-btn"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Déconnexion" onAction="#onSeDeconnecter" maxWidth="Infinity" styleClass="btn-logout"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </StackPane>
    </center>

</BorderPane>
