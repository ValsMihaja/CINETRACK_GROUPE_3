<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ProgrammationControleur"
      spacing="14">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Films, Salles et Séances" styleClass="page-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Actualiser" onAction="#rafraichirTout" styleClass="btn-secondary"/>
    </HBox>

    <Label fx:id="lblMessageProg" text="" wrapText="true"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab text="Séances">
            <VBox spacing="12">
                <padding>
                    <Insets top="12"/>
                </padding>

                <VBox spacing="10" styleClass="card">
                    <Label text="Programmer une séance" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <ComboBox fx:id="cbSeanceFilm" promptText="Film" prefWidth="220"/>
                        <ComboBox fx:id="cbSeanceSalle" promptText="Salle" prefWidth="160"/>
                        <DatePicker fx:id="dpSeanceDate" prefWidth="140"/>
                        <TextField fx:id="txtSeanceHeure" promptText="HH:mm" prefWidth="90"/>
                        <Button fx:id="btnProgrammerSeance" text="Programmer" onAction="#onProgrammerSeance" styleClass="btn-primary"/>
                        <Button fx:id="btnSupprimerSeance" text="Supprimer" onAction="#onSupprimerSeance" styleClass="btn-danger"/>
                    </HBox>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Filtres :" styleClass="field-label"/>
                    <DatePicker fx:id="dpFiltreDate" promptText="Date" prefWidth="135"/>
                    <ComboBox fx:id="cbFiltreSalle" promptText="Salle" prefWidth="150"/>
                    <ComboBox fx:id="cbFiltreFilm" promptText="Film" prefWidth="200"/>
                    <Button text="Filtrer" onAction="#onFiltrerSeances" styleClass="btn-secondary"/>
                    <Button text="Réinitialiser" onAction="#onReinitialiserFiltresSeances" styleClass="btn-secondary"/>
                </HBox>

                <TableView fx:id="tableSeances" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdSeance" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colFilmSeance" text="Film" prefWidth="250"/>
                        <TableColumn fx:id="colSalleSeance" text="Salle" prefWidth="140"/>
                        <TableColumn fx:id="colDateSeance" text="Date" prefWidth="110"/>
                        <TableColumn fx:id="colHeureSeance" text="Horaire" prefWidth="140"/>
                        <TableColumn fx:id="colPlacesSeance" text="Places dispo" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Films">
            <VBox spacing="12">
                <padding>
                    <Insets top="12"/>
                </padding>

                <VBox spacing="10" styleClass="card">
                    <Label text="Fiche film" styleClass="section-title"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtFilmTitre" promptText="Titre" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtFilmGenre" promptText="Genre" prefWidth="160"/>
                        <TextField fx:id="txtFilmDuree" promptText="Durée (min)" prefWidth="110"/>
                        <TextField fx:id="txtFilmNote" promptText="Note (0-10)" prefWidth="100"/>
                    </HBox>
                    <TextArea fx:id="txtFilmSynopsis" promptText="Synopsis" prefHeight="60"/>
                    <HBox spacing="10">
                        <Button fx:id="btnAjouterFilm" text="Ajouter" onAction="#onAjouterFilm" styleClass="btn-primary"/>
                        <Button fx:id="btnModifierFilm" text="Modifier" onAction="#onModifierFilm" styleClass="btn-secondary"/>
                        <Button fx:id="btnSupprimerFilm" text="Supprimer" onAction="#onSupprimerFilm" styleClass="btn-danger"/>
                    </HBox>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtRechercheFilmTitre" promptText="Titre" prefWidth="220"/>
                    <TextField fx:id="txtRechercheFilmGenre" promptText="Genre" prefWidth="160"/>
                    <Button text="Rechercher" onAction="#onRechercherFilms" styleClass="btn-secondary"/>
                </HBox>

                <TableView fx:id="tableFilms" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdFilm" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colTitreFilm" text="Titre" prefWidth="260"/>
                        <TableColumn fx:id="colGenreFilm" text="Genre" prefWidth="150"/>
                        <TableColumn fx:id="colDureeFilm" text="Durée (min)" prefWidth="110"/>
                        <TableColumn fx:id="colNoteFilm" text="Note" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Salles">
            <VBox spacing="12">
                <padding>
                    <Insets top="12"/>
                </padding>

                <VBox spacing="10" styleClass="card">
                    <Label text="Gestion des salles" styleClass="section-title"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtSalleNom" promptText="Nom de la salle" HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtSalleCapacite" promptText="Capacité" prefWidth="120"/>
                        <TextField fx:id="txtSalleEquipement" promptText="Équipement" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10">
                        <Button fx:id="btnAjouterSalle" text="Ajouter" onAction="#onAjouterSalle" styleClass="btn-primary"/>
                        <Button fx:id="btnModifierSalle" text="Modifier" onAction="#onModifierSalle" styleClass="btn-secondary"/>
                        <Button fx:id="btnSupprimerSalle" text="Supprimer" onAction="#onSupprimerSalle" styleClass="btn-danger"/>
                    </HBox>
                </VBox>

                <TableView fx:id="tableSalles" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdSalle" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colNomSalle" text="Nom" prefWidth="200"/>
                        <TableColumn fx:id="colCapaciteSalle" text="Capacité" prefWidth="120"/>
                        <TableColumn fx:id="colEquipementSalle" text="Équipement" prefWidth="320"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab text="Tarifs">
            <VBox spacing="12">
                <padding>
                    <Insets top="12"/>
                </padding>

                <VBox spacing="10" styleClass="card">
                    <Label text="Modifier un tarif" styleClass="section-title"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="txtTarifCategorie" editable="false" promptText="Catégorie" prefWidth="150"/>
                        <TextField fx:id="txtTarifLibelle" promptText="Libellé" prefWidth="180"/>
                        <TextField fx:id="txtTarifPrix" promptText="Prix (Rs)" prefWidth="100"/>
                        <TextField fx:id="txtTarifDescription" promptText="Description" HBox.hgrow="ALWAYS"/>
                        <CheckBox fx:id="chkTarifActif" text="Actif"/>
                        <Button fx:id="btnModifierTarif" text="Enregistrer" onAction="#onModifierTarif" styleClass="btn-primary"/>
                    </HBox>
                </VBox>

                <TableView fx:id="tableTarifs" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdTarif" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colCatTarif" text="Catégorie" prefWidth="150"/>
                        <TableColumn fx:id="colLibelleTarif" text="Libellé" prefWidth="170"/>
                        <TableColumn fx:id="colPrixTarif" text="Prix unitaire" prefWidth="120"/>
                        <TableColumn fx:id="colDescTarif" text="Description" prefWidth="320"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

</VBox>
